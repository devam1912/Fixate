# Fixate Environment Variables Configuration

# Active LLM Provider (Options: gemini | openai | ollama)
FIXATE_LLM_PROVIDER=gemini

# Free Tier Priority: Google Gemini API Key
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI API Key or Ollama Base URL
OPENAI_API_KEY=your_openai_api_key_here
OLLAMA_BASE_URL=http://localhost:11434/v1

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
