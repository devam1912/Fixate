# Fixate Environment Variables Configuration

# Active LLM Provider (Options: gemini | openai | ollama)
FIXATE_LLM_PROVIDER=gemini

# Free Tier Priority: Google Gemini API Key
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Generation Model (Gemini Flash Lite / Flash)
# Enforced Limits: 12 RPM | 250k TPM | 500 RPD
GEMINI_LLM_MODEL=gemini-2.5-flash

# Code Embedding Model (Gemini Embedding 2 / text-embedding-004)
# Enforced Limits: 90 RPM | 90k TPM | 950 RPD
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
