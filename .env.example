# Fixate Production Environment Variables

# Gemini API Key for live LLM patch generation
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Mistral / OpenAI / Ollama LLM provider configurations
# LLM_PROVIDER=gemini
# MISTRAL_API_KEY=your_mistral_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Server Port & Environment Mode
PORT=8000
APP_ENV=production

# Rate limits. Defaults sit at roughly 80% of the Gemini free tier so the local
# guard throttles before the provider refuses -- the token counts here are
# estimates, and the provider's tokenizer is the one that decides. Raise these to
# match a paid tier; the daily counters are in-process and reset with the
# container, which is why the margin exists.
#
# Embedding TPM is the binding constraint when indexing a repository.
# FIXATE_EMBED_MAX_RPM=80        # provider free tier: 100
# FIXATE_EMBED_MAX_TPM=24000     # provider free tier: 30,000
# FIXATE_EMBED_MAX_RPD=900       # provider free tier: 1,000
#
# FIXATE_LLM_MAX_RPM=12          # provider free tier: 15
# FIXATE_LLM_MAX_TPM=240000      # provider free tier: 250,000
# FIXATE_LLM_MAX_RPD=480         # provider free tier: 500
